# Copier vers .env et renseigner des valeurs réelles en local (jamais commité).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=project_harmony
DB_USER=project_harmony
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Origines autorisées à appeler l'API (le serveur de dev du frontend).
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:5173,http://localhost:4173

# Fuseau de l'agence pour les textes datés générés par le serveur
# (ex. Europe/Paris, Africa/Dakar). L'interface affiche toujours les dates
# dans le fuseau du navigateur.
DJANGO_TIME_ZONE=Europe/Paris

# Notifications push sur téléphone / ordinateur. À générer UNE fois par
# serveur avec `python manage.py generate_vapid_keys` (changer de clés
# désabonne tous les appareils). Vides : push désactivé, la cloche reste.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:empirebeba@gmail.com
