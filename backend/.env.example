# Copier vers .env et renseigner des valeurs réelles en local (jamais commité).

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=project_harmony
